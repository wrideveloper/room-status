{
	"name": "room-status",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"dev": "APP_TARGET=workers react-router dev",
		"dev:sqlite": "APP_TARGET=sqlite react-router dev",
		"build": "react-router build",
		"build:sqlite": "APP_TARGET=sqlite react-router build",
		"start": "react-router-serve ./build/server/index.js",
		"deploy": "wrangler deploy",
		"db:migrate:local": "wrangler d1 migrations apply room-status-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply room-status-db --remote",
		"cf-typegen": "wrangler types",
		"typecheck": "wrangler types && react-router typegen && tsc",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write ."
	},
	"packageManager": "pnpm@12.6.0",
	"dependencies": {
		"@fontsource/inter": "^5.3.0",
		"@hookform/resolvers": "^3.10.0",
		"@radix-ui/react-alert-dialog": "^1.1.23",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@react-router/node": "^8.4.0",
		"@react-router/serve": "^8.4.0",
		"better-sqlite3": "^13.0.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.3",
		"isbot": "^4.4.0",
		"lucide-react": "^0.445.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-hook-form": "^7.89.0",
		"react-router": "^8.4.0",
		"tailwind-merge": "^2.6.1",
		"tailwindcss-animate": "^1.0.7",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@cloudflare/vite-plugin": "^1.62.5",
		"@cloudflare/workers-types": "^5.20261005.1",
		"@react-router/dev": "^8.4.0",
		"@react-router/fs-routes": "^8.4.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"autoprefixer": "^10.6.1",
		"drizzle-kit": "^0.31.11",
		"postcss": "^8.5.28",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"vite": "^8.3.2",
		"wrangler": "^4.147.0"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
